
import React, { useMemo, useState } from "react";
import { motion } from "framer-motion";
import { Calendar, Clock, Scissors, Sparkles, User, Phone, CheckCircle2, Trash2, Instagram, MapPin } from "lucide-react";
import { Card, CardContent } from "@/components/ui/card";
import { Button } from "@/components/ui/button";

const services = [
  { id: "corte", name: "Corte", duration: "45 min", price: "$12.000", icon: Scissors },
  { id: "brushing", name: "Brushing", duration: "40 min", price: "$10.000", icon: Sparkles },
  { id: "color", name: "Coloración", duration: "120 min", price: "$28.000", icon: Sparkles },
  { id: "mechas", name: "Mechas / Balayage", duration: "180 min", price: "$45.000", icon: Sparkles },
  { id: "tratamiento", name: "Tratamiento capilar", duration: "60 min", price: "$16.000", icon: Sparkles },
];

const timeSlots = ["09:00", "10:00", "11:00", "12:00", "14:00", "15:00", "16:00", "17:00", "18:00"];

function getToday() {
  const d = new Date();
  return d.toISOString().split("T")[0];
}

export default function HairSalonBookingPage() {
  const [selectedService, setSelectedService] = useState("corte");
  const [date, setDate] = useState(getToday());
  const [time, setTime] = useState("10:00");
  const [clientName, setClientName] = useState("");
  const [phone, setPhone] = useState("");
  const [notes, setNotes] = useState("");
  const [bookings, setBookings] = useState([
    { id: 1, clientName: "Sofía", phone: "11 5555-1234", service: "Brushing", date: getToday(), time: "15:00", notes: "Tiene evento a la noche" },
  ]);
  const [message, setMessage] = useState("");

  const currentService = useMemo(
    () => services.find((s) => s.id === selectedService),
    [selectedService]
  );

  const reservedTimes = useMemo(() => {
    return bookings.filter((b) => b.date === date).map((b) => b.time);
  }, [bookings, date]);

  const availableSlots = timeSlots.map((slot) => ({
    time: slot,
    reserved: reservedTimes.includes(slot),
  }));

  function handleBooking(e) {
    e.preventDefault();
    setMessage("");

    if (!clientName.trim() || !phone.trim()) {
      setMessage("Completá el nombre y el teléfono para confirmar el turno.");
      return;
    }

    if (reservedTimes.includes(time)) {
      setMessage("Ese horario ya está reservado. Elegí otro horario disponible.");
      return;
    }

    const newBooking = {
      id: Date.now(),
      clientName: clientName.trim(),
      phone: phone.trim(),
      service: currentService.name,
      date,
      time,
      notes: notes.trim(),
    };

    setBookings((prev) => [...prev, newBooking].sort((a, b) => `${a.date} ${a.time}`.localeCompare(`${b.date} ${b.time}`)));
    setClientName("");
    setPhone("");
    setNotes("");
    setMessage("¡Turno confirmado! Te esperamos en la peluquería.");
  }

  function deleteBooking(id) {
    setBookings((prev) => prev.filter((b) => b.id !== id));
  }

  return (
    <div className="min-h-screen bg-gradient-to-br from-rose-50 via-pink-50 to-white text-stone-900">
      <header className="px-5 py-5 md:px-10">
        <div className="mx-auto flex max-w-6xl items-center justify-between rounded-3xl bg-white/80 px-5 py-4 shadow-sm backdrop-blur">
          <div className="flex items-center gap-3">
            <div className="flex h-11 w-11 items-center justify-center rounded-2xl bg-rose-500 text-white shadow-md">
              <Scissors size={22} />
            </div>
            <div>
              <p className="text-lg font-bold leading-tight">Studio Belleza</p>
              <p className="text-xs text-stone-500">Turnos online</p>
            </div>
          </div>
          <div className="hidden items-center gap-4 text-sm text-stone-600 md:flex">
            <span className="flex items-center gap-1"><MapPin size={16} /> Palermo, CABA</span>
            <span className="flex items-center gap-1"><Instagram size={16} /> @studiobelleza</span>
          </div>
        </div>
      </header>

      <main className="mx-auto grid max-w-6xl gap-6 px-5 pb-12 md:grid-cols-[1.05fr_0.95fr] md:px-10">
        <motion.section
          initial={{ opacity: 0, y: 18 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ duration: 0.45 }}
          className="rounded-[2rem] bg-white p-6 shadow-xl shadow-rose-100 md:p-8"
        >
          <div className="mb-7">
            <span className="mb-3 inline-flex rounded-full bg-rose-100 px-3 py-1 text-sm font-medium text-rose-700">Agenda rápida y simple</span>
            <h1 className="text-3xl font-black tracking-tight md:text-5xl">Reservá tu turno en minutos</h1>
            <p className="mt-3 max-w-xl text-stone-600">Elegí el servicio, la fecha y el horario. Te confirmamos el turno al instante.</p>
          </div>

          <form onSubmit={handleBooking} className="space-y-6">
            <div>
              <label className="mb-3 flex items-center gap-2 text-sm font-bold"><Sparkles size={17} /> Servicio</label>
              <div className="grid gap-3 sm:grid-cols-2">
                {services.map((service) => {
                  const Icon = service.icon;
                  const active = selectedService === service.id;
                  return (
                    <button
                      key={service.id}
                      type="button"
                      onClick={() => setSelectedService(service.id)}
                      className={`rounded-3xl border p-4 text-left transition hover:shadow-md ${active ? "border-rose-500 bg-rose-50 ring-2 ring-rose-100" : "border-stone-200 bg-white"}`}
                    >
                      <div className="flex items-start gap-3">
                        <div className={`rounded-2xl p-2 ${active ? "bg-rose-500 text-white" : "bg-stone-100 text-stone-600"}`}>
                          <Icon size={18} />
                        </div>
                        <div>
                          <p className="font-bold">{service.name}</p>
                          <p className="text-sm text-stone-500">{service.duration} · {service.price}</p>
                        </div>
                      </div>
                    </button>
                  );
                })}
              </div>
            </div>

            <div className="grid gap-4 sm:grid-cols-2">
              <div>
                <label className="mb-2 flex items-center gap-2 text-sm font-bold"><Calendar size={17} /> Fecha</label>
                <input
                  type="date"
                  min={getToday()}
                  value={date}
                  onChange={(e) => setDate(e.target.value)}
                  className="w-full rounded-2xl border border-stone-200 bg-white px-4 py-3 outline-none ring-rose-200 focus:ring-4"
                />
              </div>
              <div>
                <label className="mb-2 flex items-center gap-2 text-sm font-bold"><Clock size={17} /> Horario</label>
                <div className="grid grid-cols-3 gap-2">
                  {availableSlots.map((slot) => (
                    <button
                      key={slot.time}
                      type="button"
                      disabled={slot.reserved}
                      onClick={() => setTime(slot.time)}
                      className={`rounded-2xl px-3 py-2 text-sm font-semibold transition ${
                        slot.reserved
                          ? "cursor-not-allowed bg-stone-100 text-stone-400 line-through"
                          : time === slot.time
                          ? "bg-rose-500 text-white shadow-md"
                          : "bg-white text-stone-700 ring-1 ring-stone-200 hover:bg-rose-50"
                      }`}
                    >
                      {slot.time}
                    </button>
                  ))}
                </div>
              </div>
            </div>

            <div className="grid gap-4 sm:grid-cols-2">
              <div>
                <label className="mb-2 flex items-center gap-2 text-sm font-bold"><User size={17} /> Nombre</label>
                <input
                  value={clientName}
                  onChange={(e) => setClientName(e.target.value)}
                  placeholder="Ej: Martina López"
                  className="w-full rounded-2xl border border-stone-200 px-4 py-3 outline-none ring-rose-200 focus:ring-4"
                />
              </div>
              <div>
                <label className="mb-2 flex items-center gap-2 text-sm font-bold"><Phone size={17} /> Teléfono</label>
                <input
                  value={phone}
                  onChange={(e) => setPhone(e.target.value)}
                  placeholder="Ej: 11 1234-5678"
                  className="w-full rounded-2xl border border-stone-200 px-4 py-3 outline-none ring-rose-200 focus:ring-4"
                />
              </div>
            </div>

            <div>
              <label className="mb-2 block text-sm font-bold">Comentarios opcionales</label>
              <textarea
                value={notes}
                onChange={(e) => setNotes(e.target.value)}
                placeholder="Ej: quiero mantener el largo, tengo el pelo teñido, llego 10 minutos tarde..."
                rows={3}
                className="w-full resize-none rounded-2xl border border-stone-200 px-4 py-3 outline-none ring-rose-200 focus:ring-4"
              />
            </div>

            <Button type="submit" className="w-full rounded-2xl bg-rose-500 py-6 text-base font-bold text-white hover:bg-rose-600">
              Confirmar turno
            </Button>

            {message && (
              <div className={`flex items-center gap-2 rounded-2xl px-4 py-3 text-sm font-medium ${message.includes("confirmado") ? "bg-green-50 text-green-700" : "bg-amber-50 text-amber-700"}`}>
                <CheckCircle2 size={18} /> {message}
              </div>
            )}
          </form>
        </motion.section>

        <motion.aside
          initial={{ opacity: 0, y: 18 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ duration: 0.55, delay: 0.1 }}
          className="space-y-6"
        >
          <Card className="rounded-[2rem] border-0 bg-stone-950 text-white shadow-xl">
            <CardContent className="p-6">
              <p className="text-sm text-rose-200">Resumen del turno</p>
              <h2 className="mt-2 text-2xl font-black">{currentService?.name}</h2>
              <div className="mt-5 grid gap-3 text-sm text-stone-200">
                <span className="flex items-center gap-2"><Calendar size={17} /> {date || "Seleccioná una fecha"}</span>
                <span className="flex items-center gap-2"><Clock size={17} /> {time}</span>
                <span className="flex items-center gap-2"><Sparkles size={17} /> {currentService?.duration} · {currentService?.price}</span>
              </div>
              <div className="mt-6 rounded-3xl bg-white/10 p-4 text-sm text-stone-200">
                Tip: podés cambiar los servicios, los precios y los horarios desde el código para adaptarlo a tu peluquería.
              </div>
            </CardContent>
          </Card>

          <Card className="rounded-[2rem] border-0 bg-white shadow-xl shadow-rose-100">
            <CardContent className="p-6">
              <div className="mb-4 flex items-center justify-between">
                <div>
                  <p className="text-sm text-stone-500">Administración</p>
                  <h2 className="text-2xl font-black">Próximos turnos</h2>
                </div>
                <span className="rounded-full bg-rose-100 px-3 py-1 text-sm font-bold text-rose-700">{bookings.length}</span>
              </div>

              <div className="max-h-[430px] space-y-3 overflow-auto pr-1">
                {bookings.length === 0 ? (
                  <p className="rounded-2xl bg-stone-50 p-4 text-sm text-stone-500">Todavía no hay turnos cargados.</p>
                ) : (
                  bookings.map((b) => (
                    <div key={b.id} className="rounded-3xl border border-stone-100 bg-stone-50 p-4">
                      <div className="flex items-start justify-between gap-3">
                        <div>
                          <p className="font-bold">{b.clientName}</p>
                          <p className="text-sm text-stone-500">{b.service}</p>
                        </div>
                        <button
                          onClick={() => deleteBooking(b.id)}
                          className="rounded-xl p-2 text-stone-400 transition hover:bg-white hover:text-rose-600"
                          title="Eliminar turno"
                        >
                          <Trash2 size={17} />
                        </button>
                      </div>
                      <div className="mt-3 grid gap-1 text-sm text-stone-600">
                        <span>{b.date} · {b.time}</span>
                        <span>{b.phone}</span>
                        {b.notes && <span className="text-stone-500">Nota: {b.notes}</span>}
                      </div>
                    </div>
                  ))
                )}
              </div>
            </CardContent>
          </Card>
        </motion.aside>
      </main>
    </div>
  );
}
